{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "vite"
    },
    "pos": {
      "root": "POS",
      "framework": "vite"
    },
    "sprint-proto-1": {
      "root": "sprint-proto-1",
      "framework": "vite"
    },
    "sprint-proto-2": {
      "root": "sprint-proto-2",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}
